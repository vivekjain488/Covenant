PORT=3000

# --- API protection (production) ---
COVENANT_API_KEY=
COVENANT_ALLOW_PUBLIC_READ=true

# --- Sponsor / integration keys ---
KEEPERHUB_API_KEY=
UNISWAP_API_KEY=

# Uniswap Gateway — all URLs, tokens, and router version come from env (no app defaults).
UNISWAP_TRADING_API_URL=https://trade-api.gateway.uniswap.org/v1
UNISWAP_ROUTER_VERSION=2.0

# Probe for GET /api/integrations/uniswap/probe — set to pairs/chains valid for your key.
UNISWAP_PROBE_SWAPPER=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
UNISWAP_PROBE_TOKEN_IN=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
UNISWAP_PROBE_TOKEN_OUT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
UNISWAP_PROBE_TOKEN_IN_CHAIN_ID=1
UNISWAP_PROBE_TOKEN_OUT_CHAIN_ID=1
UNISWAP_PROBE_AMOUNT=10000000000000000
UNISWAP_PROBE_ROUTING=CLASSIC
UNISWAP_PROBE_SLIPPAGE=1

# --- Outbound webhooks after ALLOW ---
KEEPERHUB_WEBHOOK_URL=
ZEROG_AUDIT_WEBHOOK_URL=
UNISWAP_RELAY_NOTIFY_URL=

# Gensyn AXL local HTTP bridge (required for topology proxy unless you tolerate 503).
GENSYN_AXL_URL=http://127.0.0.1:9002

GUARDRAIL_REGISTRY_ADDRESS=

# --- 0G Storage SDK ---
# ZEROG_INDEXER_RPC=
# ZEROG_EVM_RPC_URL=
# ZEROG_PRIVATE_KEY=
# ZEROG_UPLOAD_REPLICAS=1
# ZEROG_API_KEY=
# ZEROG_RPC_URL=
# ZERO_G_RPC_URL=
# ZEROG_BUCKET=

# --- Optional overrides ---
# COVENANT_DEFAULT_POLICIES_PATH=./config/custom-policies.seed.json
# DEMO_SCENARIOS_PATH=./config/demo-scenarios.json
