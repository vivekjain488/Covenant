# Local dev loads `client/.env.development` automatically (committed defaults).
# Copy this file only if you want a standalone template or non-Vite tooling.

VITE_API_URL=http://127.0.0.1:3000

# Mirror server COVENANT_API_KEY only when reads are locked (see ENVIRONMENT.md).
# VITE_COVENANT_API_KEY=

# Optional label for dashboards (topology still comes from the API proxy).
# VITE_GENSYN_AXL_URL=http://127.0.0.1:9002
